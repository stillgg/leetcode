{
    "compilerOptions": {
        "target": "ESNext",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "lib": [
            "DOM",
            "ESNext",
        ],
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "moduleDetection": "force",
        "allowImportingTsExtensions": true,
    },
    "include": [
        "**/*.ts"
    ]
}